<mjml>
  <mj-head>
    <mj-title>Resetuj hasło – AKAdemy 2.0</mj-title>
    <mj-preview>Resetuj swoje hasło w AKAdemy 2.0 🔐</mj-preview>
    <mj-attributes>
      <mj-all
        font-family="'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif"
      />
      <mj-text font-size="16px" line-height="1.6" color="#334155" />
      <mj-button
        background-color="#4A90E2"
        color="#ffffff"
        font-size="18px"
        font-weight="600"
        border-radius="12px"
        inner-padding="16px 32px"
      />
    </mj-attributes>
    <mj-style> .highlight { color: #4A90E2; font-weight: 600; } </mj-style>
  </mj-head>
  <mj-body background-color="#f1f5f9">
    <!-- Header -->
    <mj-section background-color="#F0F0F0" padding="24px 20px">
      <mj-column>
        <mj-text
          align="center"
          font-size="28px"
          font-weight="700"
          color="#0E2E54"
          letter-spacing="-0.5px"
        >
          🎓 <span style="font-family: 'Inter', sans-serif">AKA</span
          ><span style="color: #4a90e2">demy</span> 2.0
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Main Content -->
    <mj-section
      background-color="#ffffff"
      padding="32px 24px"
      border-radius="0 0 16px 16px"
    >
      <mj-column>
        <mj-text align="center" font-size="48px" padding-bottom="16px">
          🔐
        </mj-text>

        <mj-text
          align="center"
          font-size="24px"
          font-weight="700"
          color="#1e293b"
          padding-bottom="8px"
        >
          Hej, <%= @resource.first_name.presence || 'Uczniu' %>!
        </mj-text>

        <mj-text align="center" padding-bottom="24px">
          Ktoś poprosił o zmianę hasła do Twojego konta w AKAdemy.<br />
          Spokojnie – to proste! 😊
        </mj-text>

        <mj-button
          href="<%= edit_password_url(@resource, reset_password_token: @token, role: @role) %>"
        >
          🔑 Ustaw nowe hasło
        </mj-button>

        <mj-text
          align="center"
          padding-top="24px"
          font-size="14px"
          color="#64748b"
        >
          Link jest ważny przez <span class="highlight">6 godzin</span>.
        </mj-text>

        <mj-divider
          border-color="#e2e8f0"
          border-width="1px"
          padding="24px 0"
        />

        <mj-text font-size="14px" color="#64748b">
          <strong>🤔 Nie prosiłeś o zmianę hasła?</strong><br />
          Bez obaw! Po prostu zignoruj ten email. Twoje hasło pozostanie bez
          zmian, dopóki nie klikniesz w powyższy przycisk.
        </mj-text>

        <% if @resource.student? %>
        <mj-text font-size="14px" color="#94a3b8" padding-top="16px">
          <strong>💡 Porada:</strong> Twój PIN to 4 cyfry, które łatwo
          zapamiętasz. Nie używaj dat urodzin ani prostych kombinacji jak
          "1234"! 🙈
        </mj-text>
        <% else %>
        <mj-text font-size="14px" color="#94a3b8" padding-top="16px">
          <strong>💡 Porada:</strong> Dobre hasło ma co najmniej 12 znaków i
          zawiera litery, cyfry oraz znaki specjalne. Nie używaj swojego imienia
          ani dat! 🙈
        </mj-text>
        <% end %>
      </mj-column>
    </mj-section>

    <!-- Footer -->
    <mj-section padding="24px 20px">
      <mj-column>
        <mj-text align="center" font-size="13px" color="#64748b">
          Ten email został wysłany automatycznie z platformy AKAdemy 2.0.<br />
          Jeśli masz pytania, napisz do nas:
          <a
            href="mailto:hello@akademy.edu.pl"
            style="color: #4a90e2; text-decoration: none"
            >hello@akademy.edu.pl</a
          >
        </mj-text>
        <mj-text
          align="center"
          font-size="12px"
          color="#94a3b8"
          padding-top="8px"
        >
          © <%= Date.current.year %>
          <a
            href="https://webgate.pro"
            style="color: #94a3b8; text-decoration: none"
            >Webgate Systems LTD</a
          >
          ·
          <a
            href="https://www.gnu.org/licenses/agpl-3.0.html"
            style="color: #94a3b8; text-decoration: none"
            >AGPLv3</a
          >
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
