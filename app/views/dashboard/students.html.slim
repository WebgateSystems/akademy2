.dashboard-app data-dashboard-app=""
  = render 'dashboard/sidebar', nav_path_helper: ->(school_class) { dashboard_students_path(class_id: school_class.id) }

  main.dashboard-main
    = render 'dashboard/top_bar', title: "Uczniowie #{@current_class&.name || ''}"

    - if @current_class
      section aria-label="Lista uczniów"
        header.schools-page__header
          label.schools-search.schools-search--half
            span.visually-hidden Szukaj uczniów
            input type="search" placeholder="Szukaj ucznia..." id="students-search-input"
            = image_tag "icons/social/S/search.svg", alt: "", "aria-hidden": "true", "data-theme-icon": true
          .schools-page__header-actions
            button.schools-page__add#add-student-btn type="button"
              span style="margin-right: 6px; font-size: 18px;" +
              | Dodaj ucznia
            = link_to dashboard_path(class_id: @current_class.id), class: "schools-page__add schools-page__add--secondary" do
              | Wróć

        .schools-page__controls

        .students-panel
          table.students-table
            thead.students-table__head
              tr
                th.students-table__heading scope="col" Imię i nazwisko
                th.students-table__heading scope="col" Data urodzenia
                th.students-table__heading scope="col" Email
                th.students-table__heading scope="col" Telefon
                th.students-table__heading scope="col" Status
                th.students-table__heading.students-table__heading--actions scope="col" Akcje
            tbody.students-table__body id="students-table-body"
              - @students.each do |student|
                - enrollment = @enrollments[student.id]
                - is_pending = enrollment&.status == 'pending'
                - is_locked = student.locked_at.present?
                - birth_date = student.birthdate&.strftime('%d.%m.%Y') || student.metadata&.dig('birth_date') || '—'
                - student_name = "#{student.first_name} #{student.last_name}"
                tr.students-table__row data-student-id=student.id
                  td.students-table__cell
                    = link_to student_name, dashboard_student_path(student, class_id: @current_class&.id), class: "student-name-link"
                  td.students-table__cell = birth_date
                  td.students-table__cell = student.email || '—'
                  td.students-table__cell = student.phone || '—'
                  td.students-table__cell
                    - if is_pending
                      span style="color: var(--content-secondary); font-weight: 500;" Oczekuje
                    - elsif is_locked
                      span style="color: var(--state-error); font-weight: 500;" Nieaktywny
                    - else
                      span style="color: var(--state-success); font-weight: 500;" Aktywny
                  td.students-table__cell.students-table__cell--actions
                    .students-actions
                      button.student-action.student-action--edit.js-edit-student type="button" aria-label="Edytuj ucznia" data-student-id=student.id data-student-first-name=student.first_name data-student-last-name=student.last_name data-student-email=student.email data-student-phone=student.phone data-student-birthdate=student.birthdate&.to_s
                        = image_tag "icons/social/S/edit.svg", alt: ""
                      - if is_pending
                        button.student-action.student-action--approve.js-approve-student type="button" aria-label="Zatwierdź ucznia" data-student-id=student.id data-student-name=student_name
                          = image_tag "icons/social/S/done.svg", alt: ""
                        button.student-action.student-action--reject.js-decline-student type="button" aria-label="Odrzuć ucznia" data-student-id=student.id data-student-name=student_name
                          = image_tag "icons/social/S/close_red.svg", alt: ""

          - if @students.empty?
            #students-empty-message.text-center style="padding: 40px; color: var(--content-secondary);"
              | Brak uczniów w tej klasie

      / Approve modal
      .schools-modal id="approve-student-modal" aria-hidden="true"
        .schools-modal__overlay
        .schools-modal__dialog role="dialog" aria-modal="true" aria-labelledby="approve-student-title"
          button.schools-modal__close type="button" aria-label="Zamknij" data-close-modal="approve-student-modal" style="position: absolute; top: 16px; right: 16px;"
            svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
              line x1="18" y1="6" x2="6" y2="18"
              line x1="6" y1="6" x2="18" y2="18"
          .schools-modal__body
            h3#approve-student-title style="margin: 0 0 16px; font-size: 24px; font-weight: 500; text-align: center;" Zatwierdź ucznia
            p#approve-student-message style="text-align: center; color: var(--content-secondary);" Czy na pewno chcesz zatwierdzić tego ucznia?
          .schools-modal__actions
            button.schools-modal__primary#approve-student-confirm-btn type="button" Zatwierdź
            button.schools-modal__secondary type="button" data-close-modal="approve-student-modal" Anuluj

      / Decline modal
      .schools-modal id="decline-student-modal" aria-hidden="true"
        .schools-modal__overlay
        .schools-modal__dialog role="dialog" aria-modal="true" aria-labelledby="decline-student-title"
          button.schools-modal__close type="button" aria-label="Zamknij" data-close-modal="decline-student-modal" style="position: absolute; top: 16px; right: 16px;"
            svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
              line x1="18" y1="6" x2="6" y2="18"
              line x1="6" y1="6" x2="18" y2="18"
          .schools-modal__body
            h3#decline-student-title style="margin: 0 0 16px; font-size: 24px; font-weight: 500; text-align: center;" Odrzuć ucznia
            p#decline-student-message style="text-align: center; color: var(--content-secondary);" Czy na pewno chcesz odrzucić tego ucznia? Tej operacji nie można cofnąć.
          .schools-modal__actions
            button.schools-modal__primary.schools-modal__primary--danger#decline-student-confirm-btn type="button" Odrzuć
            button.schools-modal__secondary type="button" data-close-modal="decline-student-modal" Anuluj

      / Add/Edit student modal
      .schools-modal id="student-form-modal" aria-hidden="true"
        .schools-modal__overlay
        .schools-modal__dialog role="dialog" aria-modal="true" aria-labelledby="student-form-title"
          button.schools-modal__close type="button" aria-label="Zamknij" data-close-modal="student-form-modal" style="position: absolute; top: 16px; right: 16px;"
            svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
              line x1="18" y1="6" x2="6" y2="18"
              line x1="6" y1="6" x2="18" y2="18"
          .schools-modal__body
            h3#student-form-title style="margin: 0 0 24px; font-size: 24px; font-weight: 500; text-align: center;" Dodaj ucznia
          form#student-form.schools-modal__form
            input type="hidden" name="student_id" id="student-form-id" value=""
            input type="hidden" name="school_class_id" id="student-form-class-id" value="#{@current_class&.id}"
            label
              span
                | Imię
                sup style="color: var(--content-secondary);"  *
              input#student-first-name type="text" name="first_name" placeholder="Imię" required=""
            label
              span
                | Nazwisko
                sup style="color: var(--content-secondary);"  *
              input#student-last-name type="text" name="last_name" placeholder="Nazwisko" required=""
            label
              span Email
              input#student-email type="email" name="email" placeholder="Opcjonalne - może być wygenerowane"
            label
              span Telefon
              input#student-phone type="tel" name="phone" placeholder="Opcjonalne - może być wygenerowane"
            label
              span Data urodzenia
              input#student-birthdate type="text" name="birthdate" placeholder="DD.MM.RRRR" inputmode="numeric" maxlength="10"
            label
              span
                | PIN
                sup style="color: var(--content-secondary);"  *
              .pin-inputs#student-pin-inputs
                input.pin-input type="text" maxlength="1" pattern="[0-9]" inputmode="numeric" data-pin-index="0" required=""
                input.pin-input type="text" maxlength="1" pattern="[0-9]" inputmode="numeric" data-pin-index="1" required=""
                input.pin-input type="text" maxlength="1" pattern="[0-9]" inputmode="numeric" data-pin-index="2" required=""
                input.pin-input type="text" maxlength="1" pattern="[0-9]" inputmode="numeric" data-pin-index="3" required=""
            #student-form-error style="display: none; color: var(--state-error); font-size: 14px; text-align: center; padding: 12px; background: rgba(239, 68, 68, 0.1); border-radius: 8px;"
            .schools-modal__actions
              button.schools-modal__primary#student-form-submit type="submit" Zapisz
              button.schools-modal__secondary type="button" data-close-modal="student-form-modal" Anuluj

      javascript:
        document.addEventListener('DOMContentLoaded', function() {
          if (typeof window.ApiClient === 'undefined') {
            console.error('ApiClient not available');
            return;
          }

          const api = new window.ApiClient();
          const API_BASE = '/management/students';
          const TEACHER_API_BASE = '/teacher/students';
          let approveStudentId = null;
          let declineStudentId = null;
          let editingStudentId = null;

          // Search functionality
          const searchInput = document.getElementById('students-search-input');
          const tbody = document.getElementById('students-table-body');
          const rows = tbody ? Array.from(tbody.querySelectorAll('.students-table__row')) : [];
          
          if (searchInput) {
            searchInput.addEventListener('input', function() {
              const searchTerm = this.value.toLowerCase().trim();
              
              rows.forEach(row => {
                const cells = row.querySelectorAll('.students-table__cell');
                const name = cells[0]?.textContent?.toLowerCase() || '';
                const birthDate = cells[1]?.textContent?.toLowerCase() || '';
                const email = cells[2]?.textContent?.toLowerCase() || '';
                const phone = cells[3]?.textContent?.toLowerCase() || '';
                const status = cells[4]?.textContent?.toLowerCase() || '';
                
                const matches = name.includes(searchTerm) || 
                               email.includes(searchTerm) || 
                               phone.includes(searchTerm) ||
                               birthDate.includes(searchTerm) ||
                               status.includes(searchTerm);
                
                row.style.display = matches ? '' : 'none';
              });
            });
          }

          // Modal handlers
          function openModal(modalId) {
            const modal = document.getElementById(modalId);
            if (modal) {
              modal.setAttribute('aria-hidden', 'false');
              modal.classList.add('is-open');
            }
          }

          function closeModal(modalId) {
            const modal = document.getElementById(modalId);
            if (modal) {
              modal.setAttribute('aria-hidden', 'true');
              modal.classList.remove('is-open');
            }
          }

          document.querySelectorAll('[data-close-modal]').forEach(btn => {
            btn.addEventListener('click', () => closeModal(btn.getAttribute('data-close-modal')));
          });

          document.querySelectorAll('.schools-modal__overlay').forEach(overlay => {
            overlay.addEventListener('click', function() {
              const modal = this.closest('.schools-modal');
              if (modal) closeModal(modal.id);
            });
          });

          // PIN inputs handling
          const pinInputs = document.querySelectorAll('.pin-input');
          pinInputs.forEach((input, index) => {
            input.addEventListener('input', (e) => {
              const value = e.target.value.replace(/[^0-9]/g, '');
              e.target.value = value;
              if (value && index < pinInputs.length - 1) {
                pinInputs[index + 1].focus();
              }
            });
            input.addEventListener('keydown', (e) => {
              if (e.key === 'Backspace' && !e.target.value && index > 0) {
                pinInputs[index - 1].focus();
              }
            });
            input.addEventListener('paste', (e) => {
              e.preventDefault();
              const paste = (e.clipboardData || window.clipboardData).getData('text').replace(/[^0-9]/g, '');
              paste.split('').slice(0, 4).forEach((char, i) => {
                if (pinInputs[i]) pinInputs[i].value = char;
              });
              if (paste.length >= 4) pinInputs[3].focus();
            });
          });

          function getPinValue() {
            return Array.from(pinInputs).map(i => i.value).join('');
          }

          function clearPinInputs() {
            pinInputs.forEach(i => i.value = '');
          }

          function setPinRequired(required) {
            pinInputs.forEach(i => i.required = required);
          }

          // Birthdate input handling - auto-format as DD.MM.RRRR
          const birthdateInput = document.getElementById('student-birthdate');
          if (birthdateInput) {
            birthdateInput.addEventListener('input', (e) => {
              let v = e.target.value.replace(/[^0-9]/g, '');
              if (v.length > 2) v = v.slice(0, 2) + '.' + v.slice(2);
              if (v.length > 5) v = v.slice(0, 5) + '.' + v.slice(5, 9);
              e.target.value = v;
            });
          }

          function clearBirthdate() {
            if (birthdateInput) birthdateInput.value = '';
          }

          function setBirthdate(dateStr) {
            if (!birthdateInput) return;
            if (!dateStr) {
              birthdateInput.value = '';
              return;
            }
            // Convert YYYY-MM-DD to DD.MM.YYYY
            const [year, month, day] = dateStr.split('-');
            if (year && month && day) {
              birthdateInput.value = `${day}.${month}.${year}`;
            } else {
              birthdateInput.value = dateStr;
            }
          }

          function getBirthdateValue() {
            if (!birthdateInput || !birthdateInput.value) return '';
            // Convert DD.MM.YYYY to YYYY-MM-DD
            const match = birthdateInput.value.match(/^(\d{2})\.(\d{2})\.(\d{4})$/);
            if (match) {
              return `${match[3]}-${match[2]}-${match[1]}`;
            }
            return birthdateInput.value;
          }

          // Add student button
          document.getElementById('add-student-btn')?.addEventListener('click', () => {
            editingStudentId = null;
            document.getElementById('student-form-title').textContent = 'Dodaj ucznia';
            document.getElementById('student-form').reset();
            document.getElementById('student-form-id').value = '';
            document.getElementById('student-form-error').style.display = 'none';
            clearPinInputs();
            clearBirthdate();
            setPinRequired(true);
            openModal('student-form-modal');
          });

          // Edit student button
          document.addEventListener('click', (e) => {
            const btn = e.target.closest('.js-edit-student');
            if (!btn) return;
            
            editingStudentId = btn.getAttribute('data-student-id');
            document.getElementById('student-form-title').textContent = 'Edytuj ucznia';
            document.getElementById('student-form-id').value = editingStudentId;
            document.getElementById('student-first-name').value = btn.getAttribute('data-student-first-name') || '';
            document.getElementById('student-last-name').value = btn.getAttribute('data-student-last-name') || '';
            document.getElementById('student-email').value = btn.getAttribute('data-student-email') || '';
            document.getElementById('student-phone').value = btn.getAttribute('data-student-phone') || '';
            setBirthdate(btn.getAttribute('data-student-birthdate') || '');
            clearPinInputs();
            setPinRequired(false); // PIN optional when editing
            document.getElementById('student-form-error').style.display = 'none';
            openModal('student-form-modal');
          });

          // Student form submit
          document.getElementById('student-form')?.addEventListener('submit', async (e) => {
            e.preventDefault();
            
            const submitBtn = document.getElementById('student-form-submit');
            const errorDiv = document.getElementById('student-form-error');
            const originalText = submitBtn.textContent;
            
            // Validate PIN for new students
            const pin = getPinValue();
            if (!editingStudentId && pin.length !== 4) {
              errorDiv.textContent = 'PIN musi składać się z 4 cyfr';
              errorDiv.style.display = 'block';
              return;
            }
            
            submitBtn.disabled = true;
            submitBtn.textContent = 'Zapisywanie...';
            errorDiv.style.display = 'none';

            const formData = {
              student: {
                first_name: document.getElementById('student-first-name').value,
                last_name: document.getElementById('student-last-name').value,
                email: document.getElementById('student-email').value || undefined,
                birthdate: getBirthdateValue() || undefined,
                school_class_id: document.getElementById('student-form-class-id').value,
                metadata: {
                  phone: document.getElementById('student-phone').value || undefined
                }
              }
            };

            // PIN is used as password
            if (pin.length === 4) {
              formData.student.password = pin;
              formData.student.password_confirmation = pin;
            }

            // Remove undefined values
            Object.keys(formData.student).forEach(key => {
              if (formData.student[key] === undefined) delete formData.student[key];
            });
            if (formData.student.metadata) {
              Object.keys(formData.student.metadata).forEach(key => {
                if (formData.student.metadata[key] === undefined) delete formData.student.metadata[key];
              });
              if (Object.keys(formData.student.metadata).length === 0) delete formData.student.metadata;
            }

            try {
              let result;
              if (editingStudentId) {
                result = await api.patch(`${TEACHER_API_BASE}/${editingStudentId}`, formData);
              } else {
                result = await api.post(TEACHER_API_BASE, formData);
              }
              
              if (result.success) {
                closeModal('student-form-modal');
                window.location.reload();
              } else {
                const errors = result.errors || result.error || 'Wystąpił błąd';
                errorDiv.textContent = Array.isArray(errors) ? errors.join(', ') : errors;
                errorDiv.style.display = 'block';
                submitBtn.disabled = false;
                submitBtn.textContent = originalText;
              }
            } catch (error) {
              console.error('Error:', error);
              errorDiv.textContent = 'Wystąpił błąd podczas zapisywania';
              errorDiv.style.display = 'block';
              submitBtn.disabled = false;
              submitBtn.textContent = originalText;
            }
          });

          // Approve student
          document.addEventListener('click', (e) => {
            const btn = e.target.closest('.js-approve-student');
            if (!btn) return;
            
            approveStudentId = btn.getAttribute('data-student-id');
            const name = btn.getAttribute('data-student-name') || 'tego ucznia';
            
            document.getElementById('approve-student-message').textContent = 
              `Czy na pewno chcesz zatwierdzić ${name}?`;
            
            openModal('approve-student-modal');
          });

          document.getElementById('approve-student-confirm-btn')?.addEventListener('click', async () => {
            if (!approveStudentId) return;
            
            const btn = document.getElementById('approve-student-confirm-btn');
            const originalText = btn.textContent;
            btn.disabled = true;
            btn.textContent = 'Zatwierdzanie...';

            try {
              const result = await api.post(`${API_BASE}/${approveStudentId}/approve`, {});
              
              if (result.success) {
                closeModal('approve-student-modal');
                window.location.reload();
              } else {
                console.error('Error:', result.error);
                btn.disabled = false;
                btn.textContent = originalText;
              }
            } catch (error) {
              console.error('Error:', error);
              btn.disabled = false;
              btn.textContent = originalText;
            }
          });

          // Decline student
          document.addEventListener('click', (e) => {
            const btn = e.target.closest('.js-decline-student');
            if (!btn) return;
            
            declineStudentId = btn.getAttribute('data-student-id');
            const name = btn.getAttribute('data-student-name') || 'tego ucznia';
            
            document.getElementById('decline-student-message').textContent = 
              `Czy na pewno chcesz odrzucić ${name}? Tej operacji nie można cofnąć.`;
            
            openModal('decline-student-modal');
          });

          document.getElementById('decline-student-confirm-btn')?.addEventListener('click', async () => {
            if (!declineStudentId) return;
            
            const btn = document.getElementById('decline-student-confirm-btn');
            const originalText = btn.textContent;
            btn.disabled = true;
            btn.textContent = 'Odrzucanie...';

            try {
              const result = await api.delete(`${API_BASE}/${declineStudentId}/decline`);
              
              if (result.success) {
                closeModal('decline-student-modal');
                window.location.reload();
              } else {
                console.error('Error:', result.error);
                btn.disabled = false;
                btn.textContent = originalText;
              }
            } catch (error) {
              console.error('Error:', error);
              btn.disabled = false;
              btn.textContent = originalText;
            }
          });
        });

    - else
      .dashboard-empty-state
        .dashboard-empty-state__content
          h2 Brak wybranej klasy
          p Wybierz klasę z menu po lewej stronie

    = render 'shared/app_version'
